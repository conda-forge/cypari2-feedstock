From 30558d5c4eb8602ae25d222c865f2ac5ba967f3d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Julian=20R=C3=BCth?= <julian.rueth@fsfe.org>
Date: Tue, 20 Oct 2026 11:52:59 -0600
Subject: [PATCH 2/2] Ignore homebrew

---
 meson.build | 10 ----------
 1 file changed, 10 deletions(-)

diff --git a/meson.build b/meson.build
index ef4d3db..f5b7f1a 100644
--- a/meson.build
+++ b/meson.build
@@ -54,16 +54,6 @@ if pari_prefix != ''
   pari_header_dirs += [pari_prefix + '/include']
   pari_lib_dirs += [pari_prefix + '/lib']
 endif
-if host_machine.system() == 'darwin'
-  brew = find_program('brew', required: false)
-  if brew.found()
-    brew_prefix = run_command(brew, '--prefix', check: true).stdout().strip()
-    message('Homebrew prefix: ' + brew_prefix)
-    pari_header_include_dirs += include_directories(brew_prefix + '/include')
-    pari_header_dirs += [brew_prefix + '/include']
-    pari_lib_dirs += [brew_prefix + '/lib']
-  endif
-endif
 
 # Explicitly check for header to give better error message (using -v to show search paths)
 cc.has_header(
-- 
2.56.1

